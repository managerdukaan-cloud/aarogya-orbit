rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.role == 'admin'; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, delete: if false;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name','phone','dob','gender','language','updatedAt']);
    }
    match /family_members/{id} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.consentConfirmed == true
        && request.resource.data.status == 'active'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80;
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.consentConfirmed == true;
      allow delete: if false;
    }

    // Doctor applications: the applicant writes their own; only the reviewApplication Cloud Function can approve or reject.
    match /doctor_applications/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.consentConfirmed == true
        && request.resource.data.keys().hasOnly(['uid','name','phone','speciality','qualification','experience','regNumber','council','clinicName','address','fee','languages','documents','status','consentConfirmed','createdAt','updatedAt'])
        && request.resource.data.experience is number && request.resource.data.fee is number
        && request.resource.data.fee >= 0 && request.resource.data.fee <= 100000
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80;
      allow update: if signedIn() && request.auth.uid == uid
        && resource.data.status in ['pending','rejected']
        && request.resource.data.status == 'pending'
        && request.resource.data.consentConfirmed == true
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name','phone','speciality','qualification','experience','regNumber','council','clinicName','address','fee','languages','documents','status','updatedAt'])
        && request.resource.data.fee is number && request.resource.data.fee >= 0 && request.resource.data.fee <= 100000;
      allow delete: if false;
    }
    // Public verified profiles. Written only by the Cloud Function after admin approval.
    match /doctors/{id} { allow read: if true; allow write: if false; }


    // Weekly timings. Public so patients can see them; only the doctor can change their own.
    match /doctor_schedules/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid && request.auth.token.role == 'doctor'
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid','weekly','slotMinutes','updatedAt'])
        && request.resource.data.slotMinutes in [10,15,20,30,45,60];
      allow delete: if false;
    }


    // Appointments and slot locks are written ONLY by Cloud Functions. Slot locks hold no personal data.
    match /appointments/{id} {
      allow read: if signedIn() && (resource.data.patientUid == request.auth.uid || resource.data.doctorUid == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /booked_slots/{id} { allow read: if true; allow write: if false; }


    // Prescriptions: written ONLY by the createPrescription Cloud Function. Read by the patient, the issuing doctor, or an admin.
    match /prescriptions/{id} {
      allow read: if signedIn() && (resource.data.patientUid == request.auth.uid || resource.data.doctorUid == request.auth.uid || isAdmin());
      allow write: if false;
    }


    // ---- Diagnostics ----
    match /lab_applications/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid
        && request.resource.data.status == 'pending' && request.resource.data.consentConfirmed == true
        && request.resource.data.keys().hasOnly(['uid','name','ownerName','phone','address','pin','licenseNo','accreditation','homeCollection','documents','status','consentConfirmed','createdAt','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100;
      allow update: if signedIn() && request.auth.uid == uid && resource.data.status in ['pending','rejected']
        && request.resource.data.status == 'pending' && request.resource.data.consentConfirmed == true
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name','ownerName','phone','address','pin','licenseNo','accreditation','homeCollection','documents','status','updatedAt']);
      allow delete: if false;
    }
    match /labs/{id} { allow read: if true; allow write: if false; }
    match /lab_settings/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid && request.auth.token.role == 'lab'
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid','weekly','slotMinutes','capacity','collectionPins','updatedAt'])
        && request.resource.data.slotMinutes in [30,60,120]
        && request.resource.data.capacity is int && request.resource.data.capacity >= 1 && request.resource.data.capacity <= 20
        && request.resource.data.collectionPins is list && request.resource.data.collectionPins.size() <= 30;
      allow delete: if false;
    }
    match /lab_pricing/{id} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.token.role == 'lab'
        && request.resource.data.labUid == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.testId
        && request.resource.data.keys().hasOnly(['labUid','testId','price','originalPrice','turnaroundHours','homeCollection','active','updatedAt'])
        && request.resource.data.price is number && request.resource.data.price > 0 && request.resource.data.price <= 100000
        && request.resource.data.originalPrice is number && request.resource.data.originalPrice >= 0 && request.resource.data.originalPrice <= 100000
        && request.resource.data.turnaroundHours is int && request.resource.data.turnaroundHours >= 1 && request.resource.data.turnaroundHours <= 720
        && request.resource.data.homeCollection is bool;
      allow delete: if signedIn() && request.auth.token.role == 'lab' && resource.data.labUid == request.auth.uid;
    }
    match /lab_slot_counts/{id} { allow read: if true; allow write: if false; }
    match /diagnostic_bookings/{id} {
      allow read: if signedIn() && (resource.data.patientUid == request.auth.uid || resource.data.labUid == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /lab_reports/{id} {
      allow read: if signedIn() && (resource.data.patientUid == request.auth.uid || resource.data.labUid == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /diagnostic_categories/{id} { allow read: if true; allow write: if isAdmin(); }


    // ---- Medical records, consent and access history (Phase 13) ----
    match /medical_records/{id} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.status == 'active'
        && request.resource.data.keys().hasOnly(['ownerUid','memberId','memberName','category','title','recordDate','file','status','createdAt'])
        && request.resource.data.category in ['blood','diagnostic','prescription','xray','mri_ct','discharge','other']
        && request.resource.data.title is string && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 100
        && request.resource.data.file.path.matches('records/' + request.auth.uid + '/.*');
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid && request.resource.data.status == 'removed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','removedAt']);
      allow delete: if false;
    }
    match /consents/{id} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.doctorUid == request.auth.uid);
      allow write: if false;
    }
    match /record_access/{id} { allow read: if signedIn() && resource.data.ownerUid == request.auth.uid; allow write: if false; }

    // ---- Hospitals and clinics (Phase 14) ----
    match /hospital_applications/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid
        && request.resource.data.status == 'pending' && request.resource.data.consentConfirmed == true
        && request.resource.data.keys().hasOnly(['uid','name','type','contactName','phone','address','pin','registrationNo','departments','documents','status','consentConfirmed','createdAt','updatedAt'])
        && request.resource.data.type in ['hospital','clinic']
        && request.resource.data.departments is list && request.resource.data.departments.size() <= 20
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100;
      allow update: if signedIn() && request.auth.uid == uid && resource.data.status in ['pending','rejected']
        && request.resource.data.status == 'pending' && request.resource.data.consentConfirmed == true
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name','type','contactName','phone','address','pin','registrationNo','departments','documents','status','updatedAt'])
        && request.resource.data.departments.size() <= 20;
      allow delete: if false;
    }
    match /hospitals/{id} {
      allow read: if true;
      allow update: if signedIn() && request.auth.uid == id && request.auth.token.role == 'hospital'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['departments','phone','updatedAt'])
        && request.resource.data.departments is list && request.resource.data.departments.size() <= 20;
      allow create, delete: if false;
    }
    match /hospital_links/{id} {
      allow read: if resource.data.status == 'active' || (signedIn() && (resource.data.hospitalUid == request.auth.uid || resource.data.doctorUid == request.auth.uid || isAdmin()));
      allow write: if false;
    }

    // ---- Support tickets and notifications (Phase 15, 16) ----
    match /support_tickets/{id} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly(['ownerUid','ownerName','role','subject','message','status','replies','createdAt','updatedAt'])
        && request.resource.data.subject is string && request.resource.data.subject.size() >= 3 && request.resource.data.subject.size() <= 100
        && request.resource.data.message is string && request.resource.data.message.size() >= 5 && request.resource.data.message.size() <= 1000
        && request.resource.data.replies.size() == 0;
      allow update, delete: if false;
    }
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }


    // ---- Platform settings, payments, reviews, packages (Phase 17-19) ----
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['commissionPct','fixedFee','onlinePaymentEnabled','updatedAt'])
        && request.resource.data.commissionPct is number && request.resource.data.commissionPct >= 0 && request.resource.data.commissionPct <= 50
        && request.resource.data.fixedFee is number && request.resource.data.fixedFee >= 0 && request.resource.data.fixedFee <= 1000
        && request.resource.data.onlinePaymentEnabled is bool;
    }
    match /payments/{id} {
      allow read: if signedIn() && (resource.data.patientUid == request.auth.uid || resource.data.providerUid == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /reviews/{id} {
      allow read: if resource.data.status == 'published' || (signedIn() && (resource.data.patientUid == request.auth.uid || isAdmin()));
      allow write: if false;
    }
    match /test_packages/{id} { allow read: if true; allow write: if isAdmin(); }
    match /lab_package_pricing/{id} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.token.role == 'lab'
        && request.resource.data.labUid == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.packageId
        && request.resource.data.keys().hasOnly(['labUid','packageId','price','originalPrice','turnaroundHours','homeCollection','active','updatedAt'])
        && request.resource.data.price is number && request.resource.data.price > 0 && request.resource.data.price <= 200000
        && request.resource.data.originalPrice is number && request.resource.data.originalPrice >= 0 && request.resource.data.originalPrice <= 200000
        && request.resource.data.turnaroundHours is int && request.resource.data.turnaroundHours >= 1 && request.resource.data.turnaroundHours <= 720
        && request.resource.data.homeCollection is bool;
      allow delete: if signedIn() && request.auth.token.role == 'lab' && resource.data.labUid == request.auth.uid;
    }

    match /specialities/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /service_areas/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /diagnostic_tests/{id} { allow read: if true; allow write: if isAdmin(); }
    match /audit_logs/{id}       { allow read: if isAdmin(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
