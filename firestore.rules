rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.role == 'admin'; }

    // Profiles are created and role-assigned ONLY by the ensureProfile Cloud Function.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if false;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }
    match /family_members/{id} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read, update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
    match /specialities/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /service_areas/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /diagnostic_tests/{id} { allow read: if true; allow write: if isAdmin(); }
    match /audit_logs/{id}       { allow read: if isAdmin(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
